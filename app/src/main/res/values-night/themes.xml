<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 夜间：窗口背景跟随 Compose DarkScheme.background，避免启动瞬间闪白 -->
    <style name="Theme.TvHelper" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0E1116</item>
        <item name="android:colorBackground">#FF0E1116</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.TvHelper.Transparent" parent="Theme.TvHelper">
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
